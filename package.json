{
  "name": "vassi-stream",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --project tsconfig.json",
    "test": "node --test \"tests/**/*.test.ts\"",
    "test:native": "cmd.exe /c scripts\\test-audio-queue.cmd",
    "test:encoder": "cmd.exe /c scripts\\test-audio-encoder.cmd",
    "test:bridge": "cmd.exe /c scripts\\test-frame-sender.cmd",
    "build:external": "cmd.exe /c scripts\\build-vassi-encoder.cmd",
    "install:external": "cmd.exe /c scripts\\install-vassi-encoder.cmd",
    "prepare:ableton": "node scripts/prepare-ableton-test.js",
    "device:build": "node scripts/make-device.js",
    "postdevice:build": "npm run device:install",
    "device:preview": "node scripts/device-preview.js",
    "version:stamp": "node scripts/stamp-version.js",
    "predevice:install": "node scripts/stamp-version.js",
    "device:install": "node scripts/install-device.js",
    "config:publisher": "node scripts/set-publisher-config.js",
    "relay": "node relay/main.ts",
    "token:new": "node scripts/new-token.js",
    "relay:check": "node scripts/check-relay.js",
    "fixture:opus": "cmd.exe /c scripts\\make-opus-fixture.cmd",
    "player:fixture": "node scripts/player-fixture.js",
    "player:sync": "node scripts/sync-player.js",
    "player:check": "node scripts/sync-player.js --check",
    "check": "npm run typecheck && npm test && npm run test:native && npm run test:encoder && npm run test:bridge && npm run player:check"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.12.0",
      "onFail": "error"
    }
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/ws": "8.18.1",
    "opus-decoder": "0.7.11",
    "typescript": "7.0.2",
    "ws": "8.21.1"
  }
}
